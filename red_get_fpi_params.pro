;; *********************************************************************

function red_get_FPI_params, instrument, w0
  
  case instrument of
    'CRISP'   : return, red_getCRISP1(w0)
    'CRISP2'  : return, red_getCRISP2(w0)
    'CHROMIS' : return, red_getCHROMIS(w0)
    else : begin
      print, 'get_FPI_params: got invalid instrument string -> ', instrument
      print, ' -> Fix your code!'
      stop
    end
  endcase
  
end


